---
import { Octokit } from "octokit";
const token = import.meta.env.GITHUB_PAT;

if (!token) {
    throw new Error("Missing organization token environment variable!");
}

type Member = {
    login: string;
    name: string | null;
    avatar_url: string;
}

export interface Props {
    member: Member;
}

const { member } = Astro.props;

---

<a href=`https://github.com/${member.login}` class="flex bg-white hover:bg-gray-50 rounded-xl gap-3 md:p-5 transition-all duration-300 hover:scale-110 shadow-md hover:shadow-lg hover:my-6">
    <img src={member.avatar_url} alt={member.name || member.login} class="min-h-24 max-h-35 w-24 object-cover rounded-l-xl md:rounded-full" />
    <div class="flex flex-col md:flex-row items-center justify-between pb-3 grow">
        <div class="flex flex-col items-center md:items-start">
            <h3 class="font-bold text-2xl text-center">{member.name || member.login}</h3>
            <span class="text-gray-500">@{member.login}</span>
        </div>
        <span class="md:bg-black hover:bg-gray-800 md:text-white md:px-3 md:py-2 md:rounded-full">View GitHub Profile</span>
    </div>
</a>