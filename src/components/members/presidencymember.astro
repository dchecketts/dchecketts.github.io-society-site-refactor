---
import danielImage from "../../assets/images/daniel-checketts.jpg";
const token = import.meta.env.GITHUB_PAT;

if (!token) {
    throw new Error("Missing organization token environment variable!");
}

type PresidencyMember = {
    title: string;
    login: string;
}

export interface Props {
    presidencyMember: PresidencyMember;
}

const { presidencyMember } = Astro.props;

import { Octokit } from 'octokit';

const octokit = new Octokit({
    auth: token
})

let profileData = null;
let errorMsg = null;

try {
    const { data } = await octokit.rest.users.getByUsername({
        username: presidencyMember.login
    });
    profileData = data;
} catch (error: any) {
    errorMsg = error.message;
}
---

<a href=`https://github.com/${presidencyMember.login}` class="flex md:flex-col md:items-center md:p-5 bg-white rounded-xl transition-all duration-300 ease-in-out hover:scale-110 shadow-md hover:shadow-lg mx-auto md:min-w-55">
    <img src={profileData?.avatar_url} alt={profileData?.name} class="h-24 w-24 object-cover rounded-l-xl md:rounded-full"/>
    <div class="grow flex flex-col items-center justify-center">
        <h3 class="font-bold text-2xl">{presidencyMember.title}</h3>
        <span class="text-gray-400 text-sm">{profileData?.name ?? profileData?.login}</span>
    </div>
</a>
