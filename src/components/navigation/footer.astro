---
import '../../styles/navigation.css'

const year = new Date().getFullYear();
const room = "STC Building Room 231";
const day = "Wednesday";
const time = "5:30 - 6:30 PM"
---

<!-- gap-3 pt-5 pb-10 -->
<footer class="bg-black text-white flex flex-col items-center py-5 gap-2">
    <span>&copy; {year} Web Dev Society</span>
    <div class="flex flex-col items-center md:flex-row md:divide-x md:divide-white">
        <!-- Join us {time} {day} at {room} -->
        <span class="md:pr-1">{room}</span>
        <span class="pl-1">{day} {time}</span>
    </div>
</footer>
