---
import { Octokit } from 'octokit';
import BasicLayout from '../../layouts/sitelayout.astro';
import memberList from '../../assets/data/members.json';

export async function getStaticPaths() {
    return memberList.map((member: any) => ({
        params: { username: member.login.toLowerCase() },
        props: { memberData: member }
    }));
}

const { memberData } = Astro.props;
const userData = memberData || { login: "unknown", name: "Unknown", avatar_url: "" };

const octokit = new Octokit();

let profileData = null;
let errorMsg = null;

try {
    const { data } = await octokit.rest.users.getByUsername({
        username: userData.login
    });
    profileData = data;
} catch (error: any) {
    errorMsg = error.message;
}
---

<BasicLayout>
    <div class="flex flex-col md:flex-row h-full p-5 gap-5">
        <!-- LEFT SIDEBAR -->
        <section id="sidebar" class="w-full h-fit md:w-1/3 flex flex-col gap-5">
            <div class="h-fit flex flex-col md:flex-row items-center md:items-start bg-white rounded-xl shadow-lg gap-3 p-5">
                <img src={profileData?.avatar_url} alt={`${profileData?.name}'s profile`} class="rounded-full w-40 h-40 object-cover mb-4" />
                <div class="flex flex-col items-center md:items-start">
                    <h1 class="font-bold text-2xl md:text-3xl text-gray-900">{profileData?.name || userData.name}</h1>
                    <a href={profileData?.html_url} target="_blank" class="text-blue-600 font-medium hover:underline mb-3">@{profileData?.login || userData.login}</a>
                    <p class="text-center md:text-left text-gray-600 text-sm mb-4">{profileData?.bio || "No bio provided."}</p>

                    {profileData?.blog &&
                            <div class="mt-2 w-full flex justify-center md:justify-start">
                                <a href={profileData?.blog.startsWith('http') ? profileData.blog : `https://${profileData.blog}`} target="_blank" class="bg-black text-white text-sm hover:bg-gray-800 rounded-full px-4 py-2 transition-all">Visit Personal Site</a>
                            </div>
                    }
                </div>
            </div>

            <!-- STATS & LANGUAGES CONTAINER -->
            <div id="statuses" class="w-full bg-white rounded-xl shadow-lg p-5 flex flex-col gap-4">
                <div class="flex justify-between items-center border-b pb-2">
                    <span class="font-bold text-gray-700">Public Repos:</span>
                    <span class="bg-gray-100 px-2.5 py-0.5 rounded-full text-sm font-semibold text-gray-800">{profileData?.public_repos || 0}</span>
                </div>
                <div>
                    <span class="font-bold text-gray-700 block mb-2">Languages Used:</span>
                    <!-- Languages will render inside this flex wrapper -->
                    <div id="languages-list" class="flex flex-wrap gap-2 text-xs font-medium">
                        <span class="text-gray-400 italic">Calculating...</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- RIGHT MAIN CONTENT (README & REPOS) -->
        <section class="w-full md:w-2/3 flex flex-col gap-5">
            <!-- PROFILE README CONTAINER -->
            <div class="bg-white rounded-xl shadow-lg p-6">
                <h2 class="text-xl font-bold mb-4 text-gray-800 border-b pb-2">About Me</h2>
                <div id="readme-loading" class="text-gray-400 italic">Fetching profile README...</div>
                <!-- Markdown-body class applies the GitHub native styling themes to the injected HTML -->
                <article id="readme-content" class="markdown-body hidden bg-gray-50 p-4 rounded-lg overflow-x-auto max-h-125 overflow-y-auto"></article>
            </div>

            <!-- PUBLIC REPOSITORIES LIST -->
            <div class="bg-white rounded-xl shadow-lg p-6">
                <h2 class="text-xl font-bold mb-4 text-gray-800 border-b pb-2">Recent Public Repositories</h2>
                <div id="repos-loading" class="text-gray-400 italic">Gathering open source repositories...</div>
                <div id="repos-list" class="flex flex-col gap-4"></div>
            </div>
        </section>
    </div>
</BasicLayout>

<!-- CLIENT SCRIPT PARSER -->
<script type="module" data-username={userData.login}>
    import { Octokit } from "https://esm.sh/octokit";

    async function loadClientPortfolioData() {
        const scriptTag = document.querySelector('script[data-username]');
        if (!scriptTag) return;

        // Force a clean string for the lookups to prevent structural scope collisions
        const currentTargetUser = String(scriptTag.dataset.username);
        const clientOctokit = new Octokit();

        try {
            const [reposResponse, readmeResponse] = await Promise.allSettled([
                clientOctokit.rest.repos.listForUser({ username: currentTargetUser, sort: "updated", per_page: 30 }),
                clientOctokit.rest.repos.getReadme({
                    owner: currentTargetUser,
                    repo: currentTargetUser,
                    headers: { accept: "application/vnd.github.html+json" },
                })
            ]);

            // --- 1. COMPILE REPOSITORIES AND CALCULATE ECOSYSTEM LANGUAGES ---
            if (reposResponse.status === "fulfilled") {
                const repos = reposResponse.value.data;
                const reposContainer = document.getElementById('repos-list');
                const languagesContainer = document.getElementById('languages-list');

                // Clear loading indicators completely
                document.getElementById('repos-loading').style.display = 'none';
                if (languagesContainer) languagesContainer.innerHTML = '';
                if (reposContainer) reposContainer.innerHTML = '';

                const languageTally = {};
                let visibleRepoCount = 0;

                repos.forEach(repo => {
                    // Filter A: Drop cloned fork repositories
                    if (repo.fork) return;

                    // Filter B: Hide the special profile documentation README repository
                    if (String(repo.name).toLowerCase() === currentTargetUser.toLowerCase()) return;

                    visibleRepoCount++;

                    // Extract and count original language tags
                    if (repo.language) {
                        languageTally[repo.language] = (languageTally[repo.language] || 0) + 1;
                    }

                    // Build repository card component markup
                    const card = document.createElement('div');
                    card.className = "border border-gray-200 rounded-lg p-4 bg-white hover:border-blue-400 transition-colors shadow-sm";
                    card.innerHTML = `
                        <div class="flex justify-between items-start">
                            <h3 class="font-bold text-blue-600 hover:underline">
                                <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer">${repo.name}</a>
                            </h3>
                            <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded font-medium">⭐ ${repo.stargazers_count}</span>
                        </div>
                        <p class="text-gray-600 text-xs mt-1 line-clamp-2">${repo.description || 'No description provided.'}</p>
                        ${repo.language ? `<div class="mt-3 text-xs text-gray-500 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-blue-500"></span>${repo.language}</div>` : ''}
                    `;
                    if (reposContainer) reposContainer.appendChild(card);
                });

                // RENDER LANGUAGE PILLS SUB-BOX
                if (languagesContainer) {
                    const sortedLanguages = Object.entries(languageTally).sort((a, b) => b[1] - a[1]);

                    if (sortedLanguages.length === 0) {
                        languagesContainer.innerHTML = `<span class="text-gray-400 italic">No original languages found</span>`;
                    } else {
                        sortedLanguages.forEach(([lang, count]) => {
                            const pill = document.createElement('span');
                            pill.className = "bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded-full font-semibold";
                            pill.innerText = `${lang} (${count})`;
                            languagesContainer.appendChild(pill);
                        });
                    }
                }

                // Empty state safeguard handling
                if (visibleRepoCount === 0 && reposContainer) {
                    reposContainer.innerHTML = `<p class="text-gray-500 text-sm italic">No other public repositories found for this account.</p>`;
                }

            } else {
                document.getElementById('repos-loading').innerText = "Unable to download portfolio repositories.";
                if (document.getElementById('languages-list')) {
                    document.getElementById('languages-list').innerText = "Error compiling summary data.";
                }
            }

            // --- 2. RENDER THE PRE-COMPILED PROFILE README ---
            if (readmeResponse.status === "fulfilled") {
                const readmeArea = document.getElementById('readme-content');
                document.getElementById('readme-loading').style.display = 'none';
                if (readmeArea) {
                    readmeArea.innerHTML = readmeResponse.value.data;
                    readmeArea.classList.remove('hidden');
                }
            } else {
                document.getElementById('readme-loading').innerHTML = `
                    <p class="text-gray-400 text-sm italic">This developer has not created a public personal profile README repository.</p>
                `;
            }

        } catch (globalFetchError) {
            console.error("Critical dashboard runtime loop breakdown:", globalFetchError);
        }
    }

    // Execute when DOM paths settle natively
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", loadClientPortfolioData);
    } else {
        loadClientPortfolioData();
    }
</script>
